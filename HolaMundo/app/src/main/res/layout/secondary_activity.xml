<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/textConfig"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TextEditActivity">

    <TextView
        android:id="@+id/textoInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola Mundo"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20sp"
        android:layout_marginStart="20sp"/>

    <TextView
        android:id="@+id/textoColor"
        android:layout_width="60sp"
        android:layout_height="60sp"
        android:text="Color"
        android:gravity="center"
        android:layout_marginStart="40sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/textoTamanyo"
        />

    <TextView
        android:id="@+id/textoTamanyo"
        android:layout_width="60sp"
        android:layout_height="60sp"
        android:text="Tamaño"
        android:gravity="center"
        android:layout_marginStart="40sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/barraTamanyo"
        />

    <SeekBar
        android:id="@+id/barraTamanyo"
        android:layout_width="250sp"
        android:layout_height="60sp"
        android:layout_marginBottom="40sp"
        android:layout_marginEnd="40sp"

        app:layout_constraintStart_toEndOf="@id/textoTamanyo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        android:max="50"
        />

    <SeekBar
        android:id="@+id/barraColor"
        android:layout_width="250sp"
        android:layout_height="60sp"
        android:layout_marginEnd="40sp"

        app:layout_constraintStart_toEndOf="@id/textoColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/barraTamanyo"

        android:max="360"
        />

</androidx.constraintlayout.widget.ConstraintLayout>